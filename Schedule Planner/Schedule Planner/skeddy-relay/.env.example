SKEDDY_RELAY_PORT=8787
SKEDDY_BOT_USERNAME=@SkeddyBot

# Required (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Must match SKEDDY_BRIDGE_WEBHOOK_SECRET in Schedule Planner app
SKEDDY_RELAY_WEBHOOK_SECRET=

# Optional
SKEDDY_RELAY_ALLOWED_EVENTS=planner_tasks_changed,planner_task_mutation
SKEDDY_RELAY_DRY_RUN=false
SKEDDY_RELAY_SEND_DELAY_MS=300

# Command templates ({{id}}, {{title}}, {{date}}, {{start}}, {{end}}, {{status}}, {{priority}}, {{tag}})
SKEDDY_CMD_CREATE_TEMPLATE={{title}} at {{date}} {{start}} {{tag}}
SKEDDY_CMD_UPDATE_TEMPLATE={{title}} at {{date}} {{start}} {{tag}}
SKEDDY_CMD_DELETE_TEMPLATE=
SKEDDY_SEND_DELETE_BEFORE_UPDATE=false

